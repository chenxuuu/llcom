<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:llcom.Avalonia.ViewModels"
             x:Class="llcom.Avalonia.Views.AboutPageView"
             x:DataType="vm:AboutViewModel">
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="16" MaxWidth="400">
            <TextBlock Text="LLCOM" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="能跑Lua脚本的串口调试工具" HorizontalAlignment="Center"/>
            <Separator/>
            <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}"/>
            <TextBlock Text="{Binding Platform, StringFormat='Platform: {0}'}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Framework, StringFormat='Runtime: {0}'}"/>
            <Separator/>
            <TextBlock Text="Developers: chenxuuu, whc2001" TextWrapping="Wrap"/>
            <Button Content="View on GitHub" Command="{Binding OpenGitHubCommand}"/>
            <Button Content="Submit Issue / Feedback" Command="{Binding OpenIssueCommand}"/>
            <Button Content="Lua API Reference" Command="{Binding OpenApiDocCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
