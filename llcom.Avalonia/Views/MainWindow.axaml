<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:llcom.Avalonia.ViewModels"
        xmlns:v="clr-namespace:llcom.Avalonia.Views"
        x:Class="llcom.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/llcom.ico"
        Title="{Binding Title}"
        Width="900" Height="500"
        MinWidth="750" MinHeight="400">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendDataCommand}"/>
    </Window.KeyBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://llcom/languages/zh-CN.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Name="MainGrid" IsEnabled="{Binding IsReady}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <!-- ====== 左侧：数据收发显示区域 ====== -->
        <Border Grid.Column="0" Grid.Row="0"
                Name="dataShowBorder"
                BorderBrush="Transparent" BorderThickness="0.5">
            <ListBox Name="dataListBox" ItemsSource="{Binding ReceivedLines}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Margin="0" Padding="0"
                     Background="Transparent" BorderThickness="0"
                     KeyDown="DataListBox_KeyDown"
                     TextInput="DataListBox_TextInput"
                     GotFocus="DataListBox_GotFocus"
                     LostFocus="DataListBox_LostFocus">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DataLineItem">
                        <TextBlock Text="{Binding DisplayText}"
                                   FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Background="Transparent"
                                   Foreground="{Binding Foreground}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ====== 左侧底部：发送数据区 ====== -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <!-- 打开/关闭串口 -->
            <Button Name="openClosePortButton" Grid.RowSpan="2" Grid.Column="0" Margin="2"
                    Command="{Binding TogglePortCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="openClosePortTextBlock"
                               Text="{Binding OpenCloseButtonText}"/>
                </StackPanel>
            </Button>

            <!-- 清空日志 -->
            <Button Name="clearLogButton" Grid.Column="1" Margin="2"
                    Command="{Binding ClearDataCommand}"
                    Content="{DynamicResource ClearLog}"/>

            <!-- 更多设置 -->
            <Button Name="MoreSettingButton" Grid.Row="1" Grid.Column="1" Margin="2"
                    Command="{Binding OpenSettingsCommand}"
                    Content="{DynamicResource MoreSettings}"
                    ToolTip.Tip="{DynamicResource MoreSettingsTip}"/>

            <!-- 数据发送框 -->
            <TextBox Name="toSendDataTextBox" Grid.RowSpan="2" Grid.Column="2"
                     MinHeight="48" Margin="2"
                     VerticalContentAlignment="Top"
                     AcceptsReturn="True"
                     FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,monospace"
                     Text="{Binding DataToSend}"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <!-- 发送按钮 -->
            <Button Name="sendDataButton" Grid.RowSpan="2" Grid.Column="3" Margin="2"
                    Command="{Binding SendDataCommand}"
                    Content="{DynamicResource SendDataButton}"
                    ToolTip.Tip="{DynamicResource SendDataButtonTip}"
                    IsEnabled="{Binding IsPortOpen}"/>
        </Grid>

        <!-- ====== GridSplitter 分割线 ====== -->
        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                      Width="5" HorizontalAlignment="Stretch"
                      Background="Transparent"/>

        <!-- ====== 右侧面板：TabControl ====== -->
        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 语言切换菜单（右上角） -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="🌐" Command="{Binding SwitchLanguageCommand}"
                        Width="28" Height="28" Margin="2"
                        Background="Transparent" ToolTip.Tip="{DynamicResource ChangeLanguage}"/>
            </StackPanel>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                <!-- 快捷发送 Tab -->
                <TabItem Header="{DynamicResource QuickSendCard}">
                    <v:QuickSendView DataContext="{Binding QuickSendPage}"/>
                </TabItem>

                <!-- Lua 脚本 Tab -->
                <TabItem Header="{DynamicResource LuaCard}">
                    <v:LuaScriptView DataContext="{Binding LuaScriptPage}"/>
                </TabItem>

                <!-- 在线脚本 Tab -->
                <TabItem Header="{DynamicResource OnlineScriptTab}">
                    <v:OnlineScriptsView DataContext="{Binding OnlineScriptsPage}"/>
                </TabItem>

                <!-- 小工具 Tab（嵌套 TabControl） -->
                <TabItem Header="{DynamicResource ToolsTab}">
                    <TabControl>
                        <TabItem Header="{DynamicResource TcpTabTitle}">
                            <v:TcpTestPageView DataContext="{Binding TcpTestPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource TcpLocalTabTitle}">
                            <v:TcpTestPageView DataContext="{Binding TcpLocalPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource UdpLocalTabTitle}">
                            <v:TcpTestPageView DataContext="{Binding UdpLocalPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource TcpClientTitle}">
                            <v:SocketClientPageView DataContext="{Binding SocketClientPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource EncodingToolsTab}">
                            <v:ConvertPageView DataContext="{Binding ConvertPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource MqttTabHeader}">
                            <v:MqttPageView DataContext="{Binding MqttPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource EncodingFixHeader}">
                            <v:EncodingFixPageView DataContext="{Binding EncodingFixPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource SerialMonitorHeader}">
                            <v:SerialMonitorView DataContext="{Binding SerialMonitorPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource PlotHeader}">
                            <v:PlotPageView DataContext="{Binding PlotPage}"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource WinUsbTabHeader}">
                            <v:WinUsbView DataContext="{Binding WinUsbPage}"/>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- 关于 Tab -->
                <TabItem Header="{DynamicResource AboutCard}">
                    <v:AboutPageView DataContext="{Binding AboutPage}"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ====== 底部状态栏（全宽） ====== -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="4,2" VerticalAlignment="Center">
                <!-- 刷新串口 -->
                <Button Name="refreshPortButton" DockPanel.Dock="Left"
                        Command="{Binding RefreshPortsCommand}"
                        Content="{DynamicResource RefreshPortButton}"
                        IsEnabled="{Binding !IsPortOpen}" Margin="0,0,4,0"/>

                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource ShowPorts}" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox Name="serialPortsListComboBox" DockPanel.Dock="Left"
                          ItemsSource="{Binding PortNames}" SelectedItem="{Binding SelectedPort}"
                          MinWidth="120" MaxWidth="250" Margin="0,0,4,0"/>

                <Separator Width="1" Height="14" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0"/>

                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource ShowBaudRate}" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox Name="baudRateComboBox" DockPanel.Dock="Left"
                          ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}"
                          Width="85" Margin="0,0,4,0"/>

                <Separator Width="1" Height="14" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0"/>

                <!-- 数据位 -->
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding DataBitsList}" SelectedItem="{Binding SelectedDataBits}"
                          Width="50" Margin="0,0,4,0"
                          ToolTip.Tip="{DynamicResource SettingDataBits}"/>

                <!-- 停止位 -->
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding StopBitsList}" SelectedItem="{Binding SelectedStopBits}"
                          Width="50" Margin="0,0,4,0"
                          ToolTip.Tip="{DynamicResource SettingStopBit}"/>

                <!-- 校验位 -->
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding ParityList}" SelectedItem="{Binding SelectedParity}"
                          Width="70" Margin="0,0,4,0"
                          ToolTip.Tip="{DynamicResource SettingParity}"/>

                <Separator Width="1" Height="14" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0"/>

                <!-- RTS / DTR -->
                <CheckBox DockPanel.Dock="Left" Content="RTS"
                          IsChecked="{Binding RtsEnabled}" Margin="2,0"
                          ToolTip.Tip="Request To Send"/>
                <CheckBox DockPanel.Dock="Left" Content="DTR"
                          IsChecked="{Binding DtrEnabled}" Margin="2,0"
                          ToolTip.Tip="Data Terminal Ready"/>

                <Separator Width="1" Height="14" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0"/>

                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource ShowStatus}" VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock Name="statusTextBlock" DockPanel.Dock="Left"
                           Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,4,0"/>

                <Separator Width="1" Height="14" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0"/>

                <TextBlock DockPanel.Dock="Right" Cursor="Cross" VerticalAlignment="Center"
                           Text="{DynamicResource ReceivedCount}" Margin="4,0"
                           ToolTip.Tip="{DynamicResource ClearCountTip}"/>
                <TextBlock Name="receivedCountTextBlock" DockPanel.Dock="Right"
                           Text="{Binding ReceivedCount}" VerticalAlignment="Center" Cursor="Cross"
                           Margin="0,0,4,0"
                           ToolTip.Tip="{DynamicResource ClearCountTip}"/>

                <Separator Width="1" Height="14" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0"/>

                <TextBlock DockPanel.Dock="Right" Cursor="Cross" VerticalAlignment="Center"
                           Text="{DynamicResource SentCount}" Margin="4,0"
                           ToolTip.Tip="{DynamicResource ClearCountTip}"/>
                <TextBlock Name="sentCountTextBlock" DockPanel.Dock="Right"
                           Text="{Binding SentCount}" VerticalAlignment="Center" Cursor="Cross"
                           Margin="0,0,4,0"
                           ToolTip.Tip="{DynamicResource ClearCountTip}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
