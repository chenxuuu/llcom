<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:llcom.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
        x:Class="llcom.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="LLCOM - 跨平台串口调试工具"
        Width="1024" Height="600"
        MinWidth="640" MinHeight="400">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Status Bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    Margin="4">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Separator Width="1" Height="16" Background="Gray" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                <Run Text="发送: "/><Run Text="{Binding SentCount}"/>
            </TextBlock>
            <TextBlock VerticalAlignment="Center">
                <Run Text="接收: "/><Run Text="{Binding ReceivedCount}"/>
            </TextBlock>
        </StackPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="4" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <WrapPanel>
                <ComboBox ItemsSource="{Binding PortNames}"
                          SelectedItem="{Binding SelectedPort}"
                          MinWidth="100" Margin="0,0,4,0"
                          ToolTip.Tip="选择串口"/>
                <Button Content="刷新" Command="{Binding RefreshPortsCommand}"
                        Margin="0,0,4,0"
                        ToolTip.Tip="刷新串口列表"/>
                <ComboBox ItemsSource="{Binding BaudRates}"
                          SelectedItem="{Binding SelectedBaudRate}"
                          MinWidth="80" Margin="0,0,4,0"
                          ToolTip.Tip="波特率"/>
                <ComboBox ItemsSource="{Binding DataBitsList}"
                          SelectedItem="{Binding SelectedDataBits}"
                          MinWidth="50" Margin="0,0,4,0"
                          ToolTip.Tip="数据位"/>
                <ComboBox ItemsSource="{Binding StopBitsList}"
                          SelectedItem="{Binding SelectedStopBits}"
                          MinWidth="50" Margin="0,0,4,0"
                          ToolTip.Tip="停止位"/>
                <ComboBox ItemsSource="{Binding ParityList}"
                          SelectedItem="{Binding SelectedParity}"
                          MinWidth="65" Margin="0,0,4,0"
                          ToolTip.Tip="校验位"/>
                <Button Content="{Binding OpenCloseButtonText}"
                        Command="{Binding TogglePortCommand}"
                        MinWidth="80" Margin="0,0,4,0"
                        Classes="accent"/>
            </WrapPanel>
        </Border>

        <!-- Send panel (bottom) -->
        <Border DockPanel.Dock="Bottom" Padding="4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                  RowDefinitions="Auto" Margin="0,2">
                <CheckBox Grid.Column="0" IsChecked="{Binding HexSend}"
                          Content="Hex" Margin="4,0"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding ShowSend}"
                          Content="显示发送" Margin="4,0"/>
                <TextBox Grid.Column="2" Text="{Binding DataToSend}"
                         Watermark="输入要发送的数据..." Margin="4,0"/>
                <Button Grid.Column="3" Content="发送" Margin="4,0"
                        Command="{Binding SendDataCommand}" Classes="accent"/>
                <CheckBox Grid.Column="4" IsChecked="{Binding HexDisplay}"
                          Content="Hex显示" Margin="4,0"/>
                <Button Grid.Column="5" Content="清除" Margin="4,0"
                        Command="{Binding ClearDataCommand}"/>
            </Grid>
        </Border>

        <!-- Main data display area -->
        <ScrollViewer>
            <TextBox Text="{Binding ReceivedData}"
                     IsReadOnly="True"
                     FontFamily="Cascadia Code,Consolas,monospace"
                     FontSize="13"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                     Padding="4"/>
        </ScrollViewer>
    </DockPanel>
</Window>
